    c.on_create(|i| {
        switch random_below(2) {
            0 => {
                i.item_id = 0x1EBA;
            },
            1 => {
                i.item_id = 0x1EBB;
            }
        }
        i.movable = true;
        i.stackable = false;
    });
});
